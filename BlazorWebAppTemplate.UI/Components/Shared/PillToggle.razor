@typeparam T

<MudToggleGroup T="T"
                Value="Value"
                ValueChanged="ValueChanged"
                Class="@($"p-1 d-flex flex-row {Class}")"
                Style="@($"border-radius: 9999px; gap: 4px; width: fit-content; border: 1px solid var(--mud-palette-lines-inputs); {Style}")"
                Color="Color"
                Delimiters="false"
                Ripple="false">
    @ChildContent
</MudToggleGroup>
