<div class="notification-snackbar-content" style="cursor: pointer;">
    <MudStack Row AlignItems="AlignItems.Start" Spacing="3">
        <MudAvatar Size="Size.Small" Class="@CategoryColorClass" Variant="Variant.Text">
            <MudIcon Icon="@CategoryIcon" Style="font-size: 16px" />
        </MudAvatar>

        <MudStack Spacing="0">
            <MudText Typo="Typo.body2" Class="fw-bold">
                @DisplayTitle
            </MudText>
            <MudText Typo="Typo.caption">
                @DisplayMessage
            </MudText>
        </MudStack>
    </MudStack>
</div>
