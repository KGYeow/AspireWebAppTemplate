@if (IsLoading)
{
    @if (LoadingContent is not null)
    {
        @LoadingContent
    }
    else
    {
        <div class="d-flex align-center justify-center" style="min-height: 200px; position: relative;">
            <LoadingOverlay Visible Text="@LoadingText" />
        </div>
    }
}
else
{
    @ChildContent
}
