@typeparam T

<CascadingValue Value="Size" Name="PillToggleSize">
    <MudToggleGroup T="T"
                    Value="Value"
                    ValueChanged="ValueChanged"
                    Size="Size"
                    Class="@($"p-1 d-flex flex-row {Class}")"
                    Style="@($"border-radius: 9999px; gap: {GetGap()}; width: fit-content; border: 1px solid var(--mud-palette-lines-inputs); {Style}")"
                    Color="Color"
                    Delimiters="false"
                    Ripple="false">
        @ChildContent
    </MudToggleGroup>
</CascadingValue>
