@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Forgot Password Confirmation</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="vh-100">
    <MudStack Class="h-75" Justify="Justify.Center">
        <MudCard Elevation="0" Class="p-4">
            <MudCardContent>
                <MudStack Class="align-content-center" AlignItems="AlignItems.Center">
                    <MudAvatar Size="Size.Large" Color="Color.Info" Variant="Variant.Filled" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Rounded.MarkEmailRead" Size="Size.Large" />
                    </MudAvatar>
                    <MudSpacer />
                    <MudText Typo="Typo.h3" Color="Color.Info" Class="fw-bold">
                        Check your email
                    </MudText>
                    <MudText Typo="Typo.body1" Class="mt-1 text-muted">
                        If an account exists for that email, we've sent a password reset link.
                        Please check your inbox.
                    </MudText>

                    <MudButton Href="Account/Login"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Class="mt-4"
                               DropShadow="false">
                        Back to Login
                    </MudButton>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudStack>
</MudContainer>
