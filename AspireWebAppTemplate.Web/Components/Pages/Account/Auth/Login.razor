@page "/Account/Login"
@layout AuthLayout
@rendermode InteractiveServer

<PageTitle>Log In</PageTitle>

<MudContainer Class="h-100 m-0 p-0">
    <MudImage Class="vw-100 vh-100"
              Src="images/backgrounds/finance-data.jpg"
              ObjectFit="ObjectFit.Cover"
              ObjectPosition="ObjectPosition.Center"
              Style="filter: brightness(0.6)" />

    <MudOverlay Modal Visible>
        <EditForm EditContext="editContext"
                  OnValidSubmit="LoginUser"
                  FormName="loginForm">
            <DataAnnotationsValidator />

            <MudCard Elevation="25" Style="width: 450px">
                <MudCardContent Class="d-flex flex-column align-items-center"
                                Style="padding: 30px">

                    <!-- Logo -->
                    <MudImage Src="images/logos/jabil-blue.svg" Width="200" />
                    <MudText Typo="Typo.caption" Class="pt-3 pb-4">
                        Please enter your details to sign in
                    </MudText>

                    <MudGrid Spacing="1">

                        <!-- Email / NTID -->
                        <MudItem xs="12">
                            <MudTextField Placeholder="@IdentifierPlaceholder"
                                          T="string"
                                          @bind-Value="Input.Email"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Typo="Typo.body2"
                                          For="@(() => Input.Email)"
                                          autocomplete="username" />
                        </MudItem>

                        <!-- Password -->
                        <MudItem xs="12">
                            <MudTextField Placeholder="Password"
                                          T="string"
                                          @bind-Value="Input.Password"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Typo="Typo.body2"
                                          For="@(() => Input.Password)"
                                          InputType="@(IsPasswordVisible ? InputType.Text : InputType.Password)"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@(IsPasswordVisible ? Icons.Material.Outlined.Visibility : Icons.Material.Outlined.VisibilityOff)"
                                          IconSize="Size.Small"
                                          OnAdornmentClick="TogglePasswordVisibility"
                                          autocomplete="current-password" />
                        </MudItem>

                        <!-- Remember Me -->
                        <MudItem xs="12">
                            <MudCheckBox @bind-Value="Input.RememberMe"
                                         Label="Remember me"
                                         Size="Size.Small"
                                         Color="Color.Primary"
                                         Dense />
                        </MudItem>

                        <!-- Error Alert -->
                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <MudItem xs="12">
                                <MudAlert Severity="Severity.Error"
                                          Class="border-1"
                                          ShowCloseIcon
                                          CloseIconClicked="ClearError">
                                    @ErrorMessage
                                </MudAlert>
                            </MudItem>
                        }

                        <!-- Login Button -->
                        <MudItem xs="12" Class="pt-4">
                            <MudButton ButtonType="ButtonType.Submit"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@IsBusy"
                                       DropShadow="false"
                                       FullWidth
                                       Style="text-transform: none;">
                                @if (IsBusy)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate Class="me-2" />
                                }
                                Log In
                            </MudButton>
                        </MudItem>

                        <MudItem xs="12">
                            <MudDivider Class="my-1" />
                        </MudItem>

                        <!-- Links -->
                        <MudItem xs="12" Class="d-flex flex-column gap-1">
                            <MudLink Href="Account/ForgotPassword" Typo="Typo.body2">
                                Forgot your password?
                            </MudLink>
                            <MudLink Href="Account/Register" Typo="Typo.body2">
                                Register as a new user
                            </MudLink>
                            <MudLink Href="Account/ResendEmailConfirmation" Typo="Typo.body2">
                                Resend email confirmation
                            </MudLink>
                        </MudItem>

                    </MudGrid>
                </MudCardContent>
            </MudCard>
        </EditForm>
    </MudOverlay>
</MudContainer>
