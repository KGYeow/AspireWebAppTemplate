@page "/Account/ForgotPassword"
@layout AuthLayout
@rendermode InteractiveServer

<PageTitle>Forgot Password</PageTitle>

<MudContainer Class="h-100 m-0 p-0">
    <MudImage Class="vw-100 vh-100"
              Src="@AssetDefaults.BackgroundAuth"
              ObjectFit="ObjectFit.Cover"
              ObjectPosition="ObjectPosition.Center"
              Style="filter: brightness(0.6)" />

    <MudOverlay Modal Visible>
        <EditForm EditContext="editContext"
                  OnValidSubmit="OnValidSubmitAsync"
                  FormName="forgotPasswordForm">
            <DataAnnotationsValidator />

            <MudCard Elevation="25" Style="width: 450px">
                <MudCardContent Class="d-flex flex-column align-items-center"
                                Style="padding: 30px">

                    <!-- Logo -->
                    <MudImage Src="@AssetDefaults.LogoAuth"
                              Width="200" />
                    <MudText Typo="Typo.caption" Class="pt-3 pb-4">
                        Enter your email to reset your password
                    </MudText>

                    <MudGrid Spacing="1">

                        <!-- Email -->
                        <MudItem xs="12">
                            <MudTextField Placeholder="Email"
                                          T="string"
                                          @bind-Value="Input.Email"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Typo="Typo.body2"
                                          For="@(() => Input.Email)"
                                          autocomplete="username" />
                        </MudItem>

                        <!-- Error Alert -->
                        <MudItem xs="12" Class="@(string.IsNullOrEmpty(ErrorMessage) ? "d-none" : "")">
                            <StatusAlert @bind-Message="ErrorMessage" />
                        </MudItem>

                        <!-- Submit Button -->
                        <MudItem xs="12" Class="pt-4">
                            <MudButton ButtonType="ButtonType.Submit"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@IsBusy"
                                       DropShadow="false"
                                       FullWidth
                                       Style="text-transform: none;">
                                @if (IsBusy)
                                {
                                    <MudProgressCircular Size="Size.Small"
                                                         Indeterminate
                                                         Class="me-2" />
                                }
                                Reset Password
                            </MudButton>
                        </MudItem>

                        <MudItem xs="12">
                            <MudDivider Class="my-1" />
                        </MudItem>

                        <!-- Links -->
                        <MudItem xs="12" Class="d-flex flex-column gap-1">
                            <MudLink Href="Account/Login" Typo="Typo.body2">
                                Back to Login
                            </MudLink>
                        </MudItem>

                    </MudGrid>
                </MudCardContent>
            </MudCard>
        </EditForm>
    </MudOverlay>
</MudContainer>
