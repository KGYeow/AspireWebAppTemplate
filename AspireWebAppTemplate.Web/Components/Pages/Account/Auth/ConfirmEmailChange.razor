@page "/Account/ConfirmEmailChange"

@using Microsoft.AspNetCore.Components

@inject NavigationManager NavigationManager

<PageTitle>Confirm email change</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="vh-100">
    <MudStack Class="h-75" Justify="Justify.Center">
        <MudCard Elevation="0" Class="p-4">
            <MudCardContent>
                <MudStack Class="align-content-center" AlignItems="AlignItems.Center">
                    <MudAvatar Size="Size.Large"
                               Color="Color.Warning"
                               Variant="Variant.Filled"
                               Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Rounded.Info" Size="Size.Large" />
                    </MudAvatar>
                    <MudText Typo="Typo.h4" Class="fw-bold">
                        Confirm Email Change
                    </MudText>
                    <MudText Typo="Typo.body1" Class="mt-1 text-muted">
                        This feature is not yet available in the current version.
                    </MudText>
                    <MudButton Href="Account/Login"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Class="mt-4"
                               DropShadow="false">
                        Back to Login
                    </MudButton>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudStack>
</MudContainer>
