@page "/Account/ConfirmEmail"

<PageTitle>Confirm Email</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="vh-100">
    <MudStack Class="h-75" Justify="Justify.Center">
        <MudCard Elevation="0" Class="p-4">
            <MudCardContent>
                <MudStack Class="align-content-center"
                          AlignItems="AlignItems.Center">

                    @if (IsSuccess)
                    {
                        <MudAvatar Size="Size.Large"
                                   Color="Color.Success"
                                   Variant="Variant.Filled"
                                   Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Rounded.CheckCircle"
                                     Size="Size.Large" />
                        </MudAvatar>
                        <MudSpacer />
                        <MudText Typo="Typo.h3"
                                 Color="Color.Success"
                                 Class="fw-bold">
                            Email confirmed
                        </MudText>
                        <MudText Typo="Typo.body1"
                                 Class="mt-1 text-muted">
                            Your email has been confirmed. You can now sign in.
                        </MudText>
                    }
                    else
                    {
                        <MudAvatar Size="Size.Large"
                                   Color="Color.Error"
                                   Variant="Variant.Filled"
                                   Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Rounded.Cancel"
                                     Size="Size.Large" />
                        </MudAvatar>
                        <MudSpacer />
                        <MudText Typo="Typo.h3"
                                 Color="Color.Error"
                                 Class="fw-bold">
                            Confirmation failed
                        </MudText>
                        <MudText Typo="Typo.body1"
                                 Class="mt-1 text-muted">
                            @StatusMessage
                        </MudText>
                    }

                    <MudButton Href="Account/Login"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Class="mt-4"
                               DropShadow="false">
                        @(IsSuccess ? "Go to Login" : "Back to Login")
                    </MudButton>

                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudStack>
</MudContainer>
