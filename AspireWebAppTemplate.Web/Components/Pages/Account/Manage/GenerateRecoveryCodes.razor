@page "/Account/Manage/GenerateRecoveryCodes"
@rendermode InteractiveServer

<PageTitle>Generate Recovery Codes</PageTitle>

@if (RecoveryCodes is not null)
{
    <PageHeader Title="Recovery Codes" Subtitle="Store these codes in a safe place." />

    <ShowRecoveryCodes RecoveryCodes="RecoveryCodes" StatusMessage="You have generated new recovery codes." />
}
else
{
    <PageHeader Title="Generate Recovery Codes" />

    <MudAlert Severity="Severity.Warning" Class="mb-4 border-1">
        <strong>Put these codes in a safe place.</strong>
        <MudText Typo="Typo.body2" Class="mt-1">
            If you lose your device and don't have the recovery codes you will lose access to your account.
            Generating new recovery codes does not change the keys used in authenticator apps. If you wish to change the key
            used in an authenticator app you should
            <MudLink Href="Account/Manage/ResetAuthenticator" Typo="Typo.body2">reset your authenticator keys.</MudLink>
        </MudText>
    </MudAlert>

    <StatusAlert @bind-Message="StatusMessage" Dismissible="false" Class="mb-4" />

    <MudButton Variant="Variant.Filled"
               Color="Color.Error"
               Disabled="@IsBusy"
               DropShadow="false"
               OnClick="OnSubmitAsync"
               Style="text-transform: none;">
        @if (IsBusy)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate Class="me-2" />
        }
        Generate Recovery Codes
    </MudButton>
}
