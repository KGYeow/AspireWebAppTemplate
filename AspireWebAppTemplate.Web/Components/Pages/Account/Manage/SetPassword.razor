@page "/Account/Manage/SetPassword"
@rendermode InteractiveServer

<PageTitle>Set Password</PageTitle>

<PageHeader Title="Set Password" Subtitle="You do not have a local password. Add one so you can log in without an external login." />

<StatusAlert @bind-Message="StatusMessage" Severity="@(StatusMessage?.StartsWith("Error") == true ? Severity.Error : Severity.Success)" Class="mb-4" />

<MudGrid>
    <MudItem xs="12" md="6">
        <EditForm EditContext="editContext"
                  OnValidSubmit="OnValidSubmitAsync"
                  FormName="setPasswordForm">
            <DataAnnotationsValidator />

            <MudStack Spacing="2">
                <MudTextField T="string"
                              @bind-Value="Input.NewPassword"
                              Label="New password"
                              Placeholder="Enter your new password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Typo="Typo.body2"
                              For="@(() => Input.NewPassword)"
                              InputType="@(IsPasswordVisible ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(IsPasswordVisible ? Icons.Material.Outlined.Visibility : Icons.Material.Outlined.VisibilityOff)"
                              IconSize="Size.Small"
                              OnAdornmentClick="() => IsPasswordVisible = !IsPasswordVisible"
                              autocomplete="new-password" />

                <MudTextField T="string"
                              @bind-Value="Input.ConfirmPassword"
                              Label="Confirm password"
                              Placeholder="Confirm your new password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Typo="Typo.body2"
                              For="@(() => Input.ConfirmPassword)"
                              InputType="@(IsConfirmVisible ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(IsConfirmVisible ? Icons.Material.Outlined.Visibility : Icons.Material.Outlined.VisibilityOff)"
                              IconSize="Size.Small"
                              OnAdornmentClick="() => IsConfirmVisible = !IsConfirmVisible"
                              autocomplete="new-password" />

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@IsBusy"
                           DropShadow="false"
                           Style="text-transform: none;">
                    @if (IsBusy)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate Class="me-2" />
                    }
                    Set password
                </MudButton>
            </MudStack>
        </EditForm>
    </MudItem>
</MudGrid>
