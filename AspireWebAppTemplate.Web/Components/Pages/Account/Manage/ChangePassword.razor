@page "/Account/Manage/ChangePassword"
@rendermode InteractiveServer

<PageTitle>Change Password</PageTitle>

<PageHeader Title="Change Password" Subtitle="Update your account password." />

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <MudAlert Severity="@(StatusMessage.StartsWith("Error") ? Severity.Error : Severity.Success)"
              Class="mb-4 border-1"
              ShowCloseIcon
              CloseIconClicked="() => StatusMessage = null">
        @StatusMessage
    </MudAlert>
}

<MudGrid>
    <MudItem xs="12" md="6">
        <EditForm EditContext="editContext"
                  OnValidSubmit="OnValidSubmitAsync"
                  FormName="changePasswordForm">
            <DataAnnotationsValidator />

            <MudStack Spacing="2">
                <MudTextField T="string"
                              @bind-Value="Input.OldPassword"
                              Label="Current password"
                              Placeholder="Enter your current password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Typo="Typo.body2"
                              For="@(() => Input.OldPassword)"
                              InputType="@(IsOldPasswordVisible ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(IsOldPasswordVisible ? Icons.Material.Outlined.Visibility : Icons.Material.Outlined.VisibilityOff)"
                              IconSize="Size.Small"
                              OnAdornmentClick="() => IsOldPasswordVisible = !IsOldPasswordVisible"
                              autocomplete="current-password" />

                <MudTextField T="string"
                              @bind-Value="Input.NewPassword"
                              Label="New password"
                              Placeholder="Enter your new password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Typo="Typo.body2"
                              For="@(() => Input.NewPassword)"
                              InputType="@(IsNewPasswordVisible ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(IsNewPasswordVisible ? Icons.Material.Outlined.Visibility : Icons.Material.Outlined.VisibilityOff)"
                              IconSize="Size.Small"
                              OnAdornmentClick="() => IsNewPasswordVisible = !IsNewPasswordVisible"
                              autocomplete="new-password" />

                <MudTextField T="string"
                              @bind-Value="Input.ConfirmPassword"
                              Label="Confirm new password"
                              Placeholder="Confirm your new password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Typo="Typo.body2"
                              For="@(() => Input.ConfirmPassword)"
                              InputType="@(IsConfirmPasswordVisible ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(IsConfirmPasswordVisible ? Icons.Material.Outlined.Visibility : Icons.Material.Outlined.VisibilityOff)"
                              IconSize="Size.Small"
                              OnAdornmentClick="() => IsConfirmPasswordVisible = !IsConfirmPasswordVisible"
                              autocomplete="new-password" />

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@IsBusy"
                           DropShadow="false"
                           Style="text-transform: none;">
                    @if (IsBusy)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate Class="me-2" />
                    }
                    Update password
                </MudButton>
            </MudStack>
        </EditForm>
    </MudItem>
</MudGrid>
