@page "/auth"

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

<PageTitle>Auth</PageTitle>

<PageHeader Title="Authentication Status" Subtitle="@UserSubtitle" />

<MudAlert Severity="Severity.Success" Class="mb-4 border-1">
    You are authenticated as <strong>@DisplayName</strong>.
</MudAlert>

@if (Roles.Count > 0)
{
    <MudText Typo="Typo.h6" Class="fw-bold mb-2">Roles</MudText>
    <MudStack Row Wrap="Wrap.Wrap" Spacing="1" Class="mb-4">
        @foreach (var role in Roles)
        {
            <MudChip T="string"
                     Color="Color.Primary"
                     Variant="Variant.Outlined"
                     Size="Size.Small">
                @role
            </MudChip>
        }
    </MudStack>
}

<MudText Typo="Typo.h6" Class="fw-bold mb-2">Claims</MudText>
<MudTable Items="@Claims"
          Dense
          Hover
          Elevation="0"
          Class="border-1">
    <HeaderContent>
        <MudTh>Type</MudTh>
        <MudTh>Value</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Type">
            <MudText Typo="Typo.body2">@context.Type</MudText>
        </MudTd>
        <MudTd DataLabel="Value">
            <MudText Typo="Typo.body2">@context.Value</MudText>
        </MudTd>
    </RowTemplate>
</MudTable>
