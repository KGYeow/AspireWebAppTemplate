@page "/weather"
@using AspireWebAppTemplate.Application.Features.Template.Notifications
@using AspireWebAppTemplate.Domain.Enums
@using AspireWebAppTemplate.Web.Services

<PageTitle>Weather</PageTitle>

<PageHeader Title="Weather" Subtitle="This component demonstrates fetching data from the API service." />

<MudDataGrid T="WeatherForecast"
             Items="@forecasts"
             Loading="@isLoading"
             Elevation="0"
             Hover
             Dense
             Filterable
             Class="px-2 pt-2">
    <NoRecordsContent>
        <MudText Typo="Typo.body2">No weather data available.</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText Typo="Typo.body2">Loading weather data from API...</MudText>
    </LoadingContent>
    <Columns>
        <PropertyColumn Property="f => f.Date" Title="Date" Format="d" />
        <PropertyColumn Property="f => f.TemperatureC" Title="Temp. (C)" />
        <PropertyColumn Property="f => f.TemperatureF" Title="Temp. (F)" />
        <PropertyColumn Property="f => f.Summary" Title="Summary" />
    </Columns>
    <PagerContent>
        <MudDataGridPager T="WeatherForecast" />
    </PagerContent>
</MudDataGrid>

<!-- Feature Testing Section -->
<MudDivider Class="my-6" />

<MudText Typo="Typo.h6" Class="fw-bold mb-2">Test Notifications</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">Send a test notification to yourself.</MudText>

<StatusAlert @bind-Message="_notificationStatus" Severity="@_notificationSeverity" Class="mb-4" />

<MudGrid>
    <MudItem xs="12" md="6">
        <MudStack Spacing="2">
            <MudSelect T="NotificationCategory"
                       @bind-Value="_selectedCategory"
                       Label="Category"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">
                <MudSelectItem Value="NotificationCategory.System">System</MudSelectItem>
                <MudSelectItem Value="NotificationCategory.Account">Account</MudSelectItem>
                <MudSelectItem Value="NotificationCategory.Activity">Activity</MudSelectItem>
            </MudSelect>

            <MudTextField T="string"
                          @bind-Value="_notificationTitle"
                          Label="Title"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />

            <MudTextField T="string"
                          @bind-Value="_notificationMessage"
                          Label="Message"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="2" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="SendTestNotification"
                       Disabled="_isSending"
                       DropShadow="false"
                       Style="text-transform: none;">
                @if (_isSending)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate Class="me-2" />
                }
                Send Test Notification
            </MudButton>
        </MudStack>
    </MudItem>
</MudGrid>
