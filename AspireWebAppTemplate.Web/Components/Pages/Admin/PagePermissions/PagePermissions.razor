@page "/admin/page-permissions"

@using AspireWebAppTemplate.Core.Contracts.PagePermissions
@using AspireWebAppTemplate.Core.Contracts.Roles

<PageTitle>Page Permissions</PageTitle>

<PageHeader Title="Page Permissions" Subtitle="Configure which roles can access which pages." />

<!-- Permanent notice: changes take effect on next refresh -->
<MudAlert Severity="Severity.Info"
          Variant="Variant.Outlined"
          Class="mb-4 border-1"
          Icon="@Icons.Material.Rounded.Info">
    Permission changes take effect on the next page refresh or new session for affected users.
</MudAlert>

<!-- Error alert -->
@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <MudAlert Severity="Severity.Error"
              Class="mb-4 border-1"
              ShowCloseIcon
              CloseIconClicked="() => ErrorMessage = null">
        @ErrorMessage
    </MudAlert>
}

<!-- Loading state -->
@if (IsLoading)
{
    <MudPaper Elevation="0" Class="pa-4">
        <MudProgressLinear Indeterminate Color="Color.Primary" Class="mb-4" />
        <MudText Typo="Typo.body2">Loading permissions matrix...</MudText>
    </MudPaper>
}
else
{
    <!-- Permission Matrix Table -->
    <MudPaper Elevation="0" Class="pa-4">
        <MudTable T="PageRow"
                  Items="_pageRows"
                  Hover
                  Dense
                  Bordered
                  Elevation="0"
                  FixedHeader
                  Height="calc(100vh - 350px)">
            <HeaderContent>
                <MudTh>Page</MudTh>
                @foreach (var role in _roles)
                {
                    <MudTh Style="text-align: center;">@(role.DisplayName ?? role.Name)</MudTh>
                }
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Page">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                        @if (!string.IsNullOrEmpty(context.Icon))
                        {
                            <MudIcon Icon="@context.Icon" Size="Size.Small" />
                        }
                        <MudText Typo="Typo.body2">@context.DisplayName</MudText>
                    </MudStack>
                </MudTd>
                @foreach (var role in _roles)
                {
                    <MudTd Style="text-align: center;">
                        @if (IsAdminRole(role))
                        {
                            @* Admin role: always checked, disabled with tooltip *@
                            <MudTooltip Text="Admin always has full access">
                                <MudSwitch T="bool"
                                           Value="true"
                                           Disabled
                                           Color="Color.Primary"
                                           Class="d-flex justify-center" />
                            </MudTooltip>
                        }
                        else if (IsRoleSaving(role.Id))
                        {
                            @* Role is saving: show loading indicator and disabled toggle *@
                            <MudProgressCircular Size="Size.Small" Indeterminate Color="Color.Primary" Class="d-flex justify-center" Style="width:24px;height:24px;" />
                        }
                        else
                        {
                            @* Regular role: interactive toggle *@
                            <MudSwitch T="bool"
                                       Value="@IsPermissionGranted(role.Id, context.PagePath)"
                                       ValueChanged="@((bool val) => OnTogglePermission(role.Id, context.PagePath, val))"
                                       Color="Color.Primary"
                                       Class="d-flex justify-center" />
                        }
                    </MudTd>
                }
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2">No configurable pages found.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}
