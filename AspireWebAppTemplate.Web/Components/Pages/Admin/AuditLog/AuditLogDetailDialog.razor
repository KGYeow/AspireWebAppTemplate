@using AspireWebAppTemplate.Application.Contracts.AuditLog

<ModalDialog Title="Audit Log Entry Details">
    <ContentArea>
        <MudSimpleTable Dense Bordered Elevation="0" Class="mb-3">
            <tbody>
                <tr>
                    <td class="fw-bold" style="width: 140px;">Timestamp</td>
                    <td>@TimeZoneContext.FormatDateTime(Entry.Timestamp)</td>
                </tr>
                <tr>
                    <td class="fw-bold">User</td>
                    <td>@Entry.UserDisplayName</td>
                </tr>
                <tr>
                    <td class="fw-bold">Action Type</td>
                    <td>@Entry.ActionType.ToString()</td>
                </tr>
                <tr>
                    <td class="fw-bold">Entity Type</td>
                    <td>@Entry.EntityType.ToString()</td>
                </tr>
                <tr>
                    <td class="fw-bold">Entity ID</td>
                    <td>@Entry.EntityId</td>
                </tr>
                <tr>
                    <td class="fw-bold">Entity Name</td>
                    <td>@Entry.EntityName</td>
                </tr>
                <tr>
                    <td class="fw-bold">Description</td>
                    <td>@Entry.Description</td>
                </tr>
                <tr>
                    <td class="fw-bold">IP Address</td>
                    <td>@(Entry.IpAddress ?? "N/A")</td>
                </tr>
                <tr>
                    <td class="fw-bold">Old Values</td>
                    <td>
                        @if (string.IsNullOrEmpty(Entry.OldValues))
                        {
                            <span class="mud-text-secondary">N/A</span>
                        }
                        else
                        {
                            <pre class="mud-typography-body2" style="white-space: pre-wrap; word-break: break-word; margin: 0;">@FormatJson(Entry.OldValues)</pre>
                        }
                    </td>
                </tr>
                <tr>
                    <td class="fw-bold">New Values</td>
                    <td>
                        @if (string.IsNullOrEmpty(Entry.NewValues))
                        {
                            <span class="mud-text-secondary">N/A</span>
                        }
                        else
                        {
                            <pre class="mud-typography-body2" style="white-space: pre-wrap; word-break: break-word; margin: 0;">@FormatJson(Entry.NewValues)</pre>
                        }
                    </td>
                </tr>
            </tbody>
        </MudSimpleTable>
    </ContentArea>

    <ActionsTemplate>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Default"
                   OnClick="() => MudDialog.Cancel()"
                   DropShadow="false">
            Close
        </MudButton>
    </ActionsTemplate>
</ModalDialog>
