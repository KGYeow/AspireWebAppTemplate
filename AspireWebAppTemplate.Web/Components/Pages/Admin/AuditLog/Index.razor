@page "/admin/audit-log"

@using AspireWebAppTemplate.Core.Domain.Enums

<PageTitle>Audit Log</PageTitle>

<PageHeader Title="Audit Log" Subtitle="Review application activity and security events." />

<!-- Action Buttons Row -->
<MudStack Row Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
    <MudButton Color="Color.Primary"
               Variant="Variant.Filled"
               StartIcon="@Icons.Material.Rounded.Download"
               OnClick="ExportAsync"
               Disabled="@(IsExporting || _totalItems == 0)"
               DropShadow="false"
               Style="text-transform: none;">
        @if (IsExporting)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate Class="mr-1" />
            <text>Exporting...</text>
        }
        else
        {
            <text>Export Excel</text>
        }
    </MudButton>
</MudStack>

<!-- Audit Log Data Grid — Server-Side Filtering, Sorting & Pagination -->
<MudPaper Elevation="0" Class="pa-4">
    <!-- Filters Row -->
    <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Class="mb-4">
        <!-- Search Filter -->
        <MudTextField T="string"
                      ValueChanged="@(s => OnSearch(s))"
                      Placeholder="Search audit entries..."
                      Variant="Variant.Outlined"
                      Typo="Typo.body2"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Rounded.Search"
                      IconSize="Size.Small"
                      DebounceInterval="500" />

        <!-- Action Type dropdown filter -->
        <MudSelect T="AuditActionType?"
                   Value="_actionTypeFilter"
                   ValueChanged="OnActionTypeChanged"
                   Placeholder="Action Type"
                   Variant="Variant.Outlined"
                   Typo="Typo.body2"
                   Margin="Margin.Dense"
                   Clearable
                   Dense
                   Style="min-width: 160px;">
            @foreach (var actionType in Enum.GetValues<AuditActionType>())
            {
                <MudSelectItem T="AuditActionType?" Value="@actionType">@actionType</MudSelectItem>
            }
        </MudSelect>

        <!-- Entity Type dropdown filter -->
        <MudSelect T="AuditEntityType?"
                   Value="_entityTypeFilter"
                   ValueChanged="OnEntityTypeChanged"
                   Placeholder="Entity Type"
                   Variant="Variant.Outlined"
                   Typo="Typo.body2"
                   Margin="Margin.Dense"
                   Clearable
                   Dense
                   Style="min-width: 140px;">
            @foreach (var entityType in Enum.GetValues<AuditEntityType>())
            {
                <MudSelectItem T="AuditEntityType?" Value="@entityType">@entityType</MudSelectItem>
            }
        </MudSelect>

        <!-- Date range picker -->
        <MudDateRangePicker @ref="_picker"
                            DateRange="_dateRange"
                            DateRangeChanged="OnDateRangeChanged"
                            Placeholder="Date Range"
                            DateFormat="yyyy-MM-dd"
                            Variant="Variant.Outlined"
                            Margin="Margin.Dense"
                            IconSize="Size.Small"
                            PickerVariant="PickerVariant.Dialog"
                            Style="min-width: 220px; font-size: 14px;">
            <PickerActions>
                <MudButton Class="mr-auto align-self-start" OnClick="@(() => _picker.ClearAsync())">Clear</MudButton>
                <MudButton OnClick="@(() => _picker.CloseAsync(false))">Cancel</MudButton>
                <MudButton Color="Color.Primary" OnClick="@(() => _picker.CloseAsync())">OK</MudButton>
            </PickerActions>
        </MudDateRangePicker>
    </MudStack>

    <!-- Audit Log Data Grid -->
    <MudDataGrid T="AuditLogViewModel"
                 @ref="_dataGrid"
                 ServerData="ServerReload"
                 Loading="@IsLoading"
                 RowClick="OnRowClick"
                 Elevation="0"
                 Hover
                 Dense
                 Bordered>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">No audit entries found.</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudText Typo="Typo.body2">Loading audit entries...</MudText>
        </LoadingContent>
        <Columns>
            <TemplateColumn Title="#" Sortable="false" Filterable="false">
                <CellTemplate>
                    @context.Item.LineNumber
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Timestamp" Sortable="false">
                <CellTemplate>
                    @TimeZoneContext.FormatDateTime(context.Item.Timestamp)
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.UserDisplayName" Title="User" />
            <PropertyColumn Property="x => x.ActionType" Title="Action Type" />
            <PropertyColumn Property="x => x.EntityType" Title="Entity Type" />
            <PropertyColumn Property="x => x.EntityName" Title="Entity Name" />
            <PropertyColumn Property="x => x.Description" Title="Description" />
        </Columns>
        <PagerContent>
            <MudDataGridPager T="AuditLogViewModel" />
        </PagerContent>
    </MudDataGrid>
</MudPaper>
