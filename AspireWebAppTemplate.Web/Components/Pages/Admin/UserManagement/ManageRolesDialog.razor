<MudDialog TitleClass="px-4 pt-5 pb-2" ContentClass="px-4" ActionsClass="px-4 pb-5">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="pb-2 fw-bold">Manage Roles</MudText>
        <MudDivider />
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                User: @UserDisplayName
            </MudText>

            <MudText Typo="Typo.body2">
                Select one or more roles for this user.
            </MudText>

            <!-- Multi-select role table -->
            <MudTable T="string"
                      Items="@AllRoleNames"
                      SelectedItems="@SelectedRoles"
                      SelectedItemsChanged="OnRolesChanged"
                      SelectOnRowClick="false"
                      Elevation="0"
                      MultiSelection
                      Hover
                      Dense
                      Bordered
                      ReadOnly>
                <HeaderContent>
                    <MudTh>Role</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Role">
                        <MudText Typo="Typo.body2">@context</MudText>
                    </MudTd>
                </RowTemplate>
                <FooterContent>
                    <MudTd>Select All</MudTd>
                </FooterContent>
            </MudTable>

            <MudAlert Severity="Severity.Info" Dense Class="mt-2">
                Changes are applied when you click <b>Save</b>.
            </MudAlert>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(!HasChanges)"
                   OnClick="Confirm"
                   DropShadow="false">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>
