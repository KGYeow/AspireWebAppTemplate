<ModalDialog Title="Add User">
    <ContentArea>
        <EditForm EditContext="editContext" OnValidSubmit="OnSubmitAsync">
            <DataAnnotationsValidator />

            <MudGrid Spacing="4">
                <!-- Email -->
                <MudItem xs="12">
                    <MudInputLabel>Email *</MudInputLabel>
                    <MudTextField T="string"
                                  @bind-Value="Input.Email"
                                  Placeholder="user@example.com"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Typo="Typo.body2"
                                  For="@(() => Input.Email)" />
                </MudItem>

                <!-- Display Name -->
                <MudItem xs="12">
                    <MudInputLabel>Display Name *</MudInputLabel>
                    <MudTextField T="string"
                                  @bind-Value="Input.DisplayName"
                                  Placeholder="John Doe"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Typo="Typo.body2"
                                  For="@(() => Input.DisplayName)" />
                </MudItem>

                <!-- Password -->
                <MudItem xs="12" sm="6">
                    <MudInputLabel>Password *</MudInputLabel>
                    <MudTextField T="string"
                                  @bind-Value="Input.Password"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Typo="Typo.body2"
                                  For="@(() => Input.Password)"
                                  InputType="InputType.Password"
                                  autocomplete="new-password" />
                </MudItem>

                <!-- Confirm Password -->
                <MudItem xs="12" sm="6">
                    <MudInputLabel>Confirm Password *</MudInputLabel>
                    <MudTextField T="string"
                                  @bind-Value="Input.ConfirmPassword"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Typo="Typo.body2"
                                  For="@(() => Input.ConfirmPassword)"
                                  InputType="InputType.Password"
                                  autocomplete="new-password" />
                </MudItem>

                <!-- Role -->
                <MudItem xs="12">
                    <MudInputLabel>Role</MudInputLabel>
                    <MudSelect T="string"
                               @bind-Value="Input.Role"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Typo="Typo.body2"
                               Dense>
                        @foreach (var role in AllRoleNames)
                        {
                            <MudSelectItem Value="@role">@role</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- Error Alert -->
                @if (!string.IsNullOrEmpty(StatusMessage))
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Error" Class="border-1">@StatusMessage</MudAlert>
                    </MudItem>
                }
            </MudGrid>
        </EditForm>
    </ContentArea>

    <ActionsTemplate>
        <MudButton Disabled="@IsBusy" OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@IsBusy"
                   OnClick="OnSubmitAsync"
                   DropShadow="false">
            @if (IsBusy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate Class="me-2" />
            }
            Add User
        </MudButton>
    </ActionsTemplate>
</ModalDialog>
