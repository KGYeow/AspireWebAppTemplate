@using AspireWebAppTemplate.Application.Common
@using AspireWebAppTemplate.Application.Features.Template.Authentication
@using AspireWebAppTemplate.Application.Features.Template.AuditLog
@using AspireWebAppTemplate.Application.Features.Template.Roles
@using AspireWebAppTemplate.Application.Features.Template.Users

<ModalDialog Title="Assign Users to Role">
    <ContentArea>
        <MudStack Spacing="3">
            <!-- Search Input -->
            <MudTextField T="string"
                          Value="@SearchTerm"
                          ValueChanged="OnSearchAsync"
                          Placeholder="Search by username or display name..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Typo="Typo.body2"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          DebounceInterval="300" />

            <!-- Selected Users Summary -->
            @if (SelectedUsers.Count > 0)
            {
                <MudPaper Class="pa-2 border rounded mud-border-primary" Elevation="0">
                    <MudText Typo="Typo.caption" Class="mb-1 fw-bold">Selected (@SelectedUsers.Count):</MudText>
                    <MudStack Row Wrap="Wrap.Wrap" Spacing="1">
                        @foreach (var user in SelectedUsers)
                        {
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="Color.Primary"
                                     Variant="Variant.Outlined"
                                     OnClose="() => RemoveFromSelection(user)">
                                @(user.DisplayName ?? user.UserName)
                            </MudChip>
                        }
                    </MudStack>
                </MudPaper>
            }

            <!-- Search Results -->
            @if (IsSearching)
            {
                <MudProgressLinear Indeterminate Color="Color.Primary" />
            }
            else if (SearchResults.Count > 0)
            {
                <MudList T="UserDto" Dense Class="border rounded mud-border-primary" Style="max-height: 250px; overflow-y: auto;">
                    @foreach (var user in SearchResults)
                    {
                        <MudListItem T="UserDto"
                                     OnClick="() => ToggleUserSelection(user)"
                                     Class="@(IsUserSelected(user) ? "mud-primary-text" : "")">
                            <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                                <MudCheckBox T="bool"
                                             Value="@IsUserSelected(user)"
                                             Size="Size.Small"
                                             Color="Color.Primary"
                                             ReadOnly />
                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2" Class="fw-bold">@user.UserName</MudText>
                                    @if (!string.IsNullOrEmpty(user.DisplayName))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@user.DisplayName</MudText>
                                    }
                                </MudStack>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            }
            else if (!string.IsNullOrWhiteSpace(SearchTerm) && SearchTerm.Length >= 2)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No users found matching "@SearchTerm".</MudText>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">Type at least 2 characters to search.</MudText>
            }

            <!-- Error Alert -->
            <StatusAlert @bind-Message="StatusMessage" Dense="true" Dismissible="false" Class="" />
        </MudStack>
    </ContentArea>

    <ActionsTemplate>
        <MudButton Disabled="@IsBusy" OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@(IsBusy || SelectedUsers.Count == 0)"
                   OnClick="OnConfirmAsync"
                   DropShadow="false">
            @if (IsBusy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate Class="me-2" />
            }
            Assign (@SelectedUsers.Count)
        </MudButton>
    </ActionsTemplate>
</ModalDialog>
