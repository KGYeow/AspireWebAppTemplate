@page "/announcements"
@using AspireWebAppTemplate.Application.Features.Template.Announcements
@using AspireWebAppTemplate.Domain.Enums

<PageTitle>Announcements</PageTitle>

<PageContent IsLoading="_isLoading">
    <PageHeader Title="Announcements" />

    <!-- Master-Detail Layout -->
    @if (_announcements.Count == 0 && !_isLoading)
    {
        <MudPaper Class="pa-8" Elevation="0">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Outlined.Campaign"
                         Size="Size.Large"
                         Color="Color.Default" />
                <MudText Typo="Typo.body1" Color="Color.Secondary">No announcements found</MudText>
            </MudStack>
        </MudPaper>
    }
    else if (_isSmallScreen && _selectedAnnouncementId.HasValue)
    {
        <!-- Small screen: detail view only with back button -->
        var selectedAnnouncement = _announcements.FirstOrDefault(a => a.Id == _selectedAnnouncementId);
        if (selectedAnnouncement is not null)
        {
            <MudPaper Elevation="0" Class="pa-4 d-flex flex-column" Style="height: calc(100vh - 160px);">
                <MudButton Variant="Variant.Text"
                           StartIcon="@Icons.Material.Outlined.ArrowBack"
                           OnClick="HandleBackToList"
                           Color="Color.Default"
                           Size="Size.Small"
                           Class="align-self-start mb-2">
                    Back to list
                </MudButton>

                <div class="flex-grow-1 overflow-y-auto pa-2">
                    <MudStack Spacing="3">
                        <!-- Header: Severity chip + published date + expired chip -->
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="@GetSeverityColor(selectedAnnouncement.Severity)"
                                     Variant="Variant.Filled">
                                @selectedAnnouncement.Severity
                            </MudChip>
                            <MudText Typo="Typo.caption" Class="text-muted">
                                Published @FormatRelativeTime(selectedAnnouncement.CreatedAtUtc)
                            </MudText>
                            @if (IsExpired(selectedAnnouncement))
                            {
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="Color.Error"
                                         Variant="Variant.Outlined">
                                    Expired @UserTimeZone.FormatDateTime(selectedAnnouncement.ExpiresAtUtc)
                                </MudChip>
                            }
                        </MudStack>

                        <MudDivider />

                        <MudText Typo="Typo.h6">@selectedAnnouncement.Title</MudText>

                        <!-- Full HTML content -->
                        <div class="announcement-content">
                            @((MarkupString)selectedAnnouncement.Message)
                        </div>
                    </MudStack>
                </div>
            </MudPaper>
        }
    }
    else
    {
        <MudPaper Elevation="0" Class="px-4 pt-4" Style="height: calc(100vh - 160px);">
            <MudGrid Spacing="4" Class="h-100">

                <!-- Announcement List Panel -->
                <MudItem xs="12" md="5" Class="h-100 d-flex flex-column">
                    <!-- Inline Filters -->
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="pb-2">
                        <!-- Severity Filter -->
                        <MudSelect T="AnnouncementSeverity?"
                                   Value="_selectedSeverity"
                                   ValueChanged="OnSeverityFilterChanged"
                                   Placeholder="Severity"
                                   Variant="Variant.Outlined"
                                   Typo="Typo.body2"
                                   Margin="Margin.Dense"
                                   Dense
                                   Clearable
                                   Style="width: 130px;">
                            <MudSelectItem T="AnnouncementSeverity?" Value="@((AnnouncementSeverity?)AnnouncementSeverity.Info)">Info</MudSelectItem>
                            <MudSelectItem T="AnnouncementSeverity?" Value="@((AnnouncementSeverity?)AnnouncementSeverity.Warning)">Warning</MudSelectItem>
                            <MudSelectItem T="AnnouncementSeverity?" Value="@((AnnouncementSeverity?)AnnouncementSeverity.Critical)">Critical</MudSelectItem>
                        </MudSelect>
                    </MudStack>

                    <!-- Scrollable List -->
                    <div class="flex-grow-1 overflow-y-auto">
                        <MudList T="AnnouncementDto" Dense Class="pa-0 announcement-page-list">
                            @foreach (var announcement in _announcements)
                            {
                                <MudListItem T="AnnouncementDto"
                                             OnClick="() => HandleAnnouncementClick(announcement)"
                                             Class="@GetAnnouncementItemClass(announcement)">
                                    <MudStack Spacing="0" Class="@($"overflow-hidden {(IsExpired(announcement) ? "announcement-expired" : "")}")">
                                        <!-- Severity chip + Title row -->
                                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                            <MudChip T="string"
                                                     Size="Size.Small"
                                                     Color="@GetSeverityColor(announcement.Severity)"
                                                     Variant="Variant.Filled"
                                                     Class="ma-0">
                                                @announcement.Severity
                                            </MudChip>
                                            <MudText Typo="Typo.body2"
                                                     Class="fw-bold"
                                                     Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1;">
                                                @announcement.Title
                                            </MudText>
                                        </MudStack>

                                        <!-- Content snippet (2-line truncated) -->
                                        <MudText Typo="Typo.caption"
                                                 Style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis;"
                                                 Class="mt-1">
                                            @StripHtml(announcement.Message)
                                        </MudText>

                                        <!-- Timestamp + Expired label -->
                                        <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Class="mt-1">
                                            <MudText Typo="Typo.caption" Class="text-muted">
                                                @FormatRelativeTime(announcement.CreatedAtUtc)
                                            </MudText>
                                            @if (IsExpired(announcement))
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Error">
                                                    · Expired
                                                </MudText>
                                            }
                                        </MudStack>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>

                        <!-- Infinite Scroll Sentinel -->
                        @if (_hasNextPage)
                        {
                            <div @ref="_scrollSentinel" class="pa-2">
                                @if (_isLoadingMore)
                                {
                                    <MudStack Row Justify="Justify.Center">
                                        <MudProgressCircular Size="Size.Small" Indeterminate />
                                    </MudStack>
                                }
                            </div>
                        }
                    </div>
                </MudItem>

                <!-- Detail Panel (desktop only) -->
                @if (!_isSmallScreen)
                {
                    <MudItem md="7" Class="h-100 d-flex flex-column">
                        @if (_selectedAnnouncementId.HasValue)
                        {
                            var detail = _announcements.FirstOrDefault(a => a.Id == _selectedAnnouncementId);
                            if (detail is not null)
                            {
                                <div class="flex-grow-1 overflow-y-auto pa-2">
                                    <MudStack Spacing="3">
                                        <!-- Header: Severity chip + published date + expired chip -->
                                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                                            <MudChip T="string"
                                                     Size="Size.Small"
                                                     Color="@GetSeverityColor(detail.Severity)"
                                                     Variant="Variant.Filled">
                                                @detail.Severity
                                            </MudChip>
                                            <MudText Typo="Typo.caption" Class="text-muted">
                                                Published @FormatRelativeTime(detail.CreatedAtUtc)
                                            </MudText>
                                            @if (IsExpired(detail))
                                            {
                                                <MudChip T="string"
                                                         Size="Size.Small"
                                                         Color="Color.Error"
                                                         Variant="Variant.Outlined">
                                                    Expired @UserTimeZone.FormatDateTime(detail.ExpiresAtUtc)
                                                </MudChip>
                                            }
                                        </MudStack>

                                        <MudDivider />

                                        <MudText Typo="Typo.h6">@detail.Title</MudText>

                                        <!-- Full HTML content -->
                                        <div class="announcement-content">
                                            @((MarkupString)detail.Message)
                                        </div>
                                    </MudStack>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="flex-grow-1 d-flex align-center justify-center">
                                <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Outlined.Campaign"
                                             Size="Size.Large"
                                             Color="Color.Default" />
                                    <MudText Typo="Typo.body1" Color="Color.Secondary">
                                        Select an announcement to view details
                                    </MudText>
                                </MudStack>
                            </div>
                        }
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>
    }
</PageContent>
