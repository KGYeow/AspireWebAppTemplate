<ModalDialog Title="Add Role">
    <ContentArea>
        <EditForm EditContext="editContext" OnValidSubmit="OnSubmitAsync">
            <DataAnnotationsValidator />

            <MudGrid Spacing="4">
                <!-- Role Name -->
                <MudItem xs="12">
                    <MudInputLabel>Role Name *</MudInputLabel>
                    <MudTextField T="string"
                                  @bind-Value="Input.Name"
                                  Placeholder="e.g. Admin"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Typo="Typo.body2"
                                  Counter="50"
                                  MaxLength="50"
                                  For="@(() => Input.Name)" />
                </MudItem>

                <!-- Display Name -->
                <MudItem xs="12">
                    <MudInputLabel>Display Name</MudInputLabel>
                    <MudTextField T="string"
                                  @bind-Value="Input.DisplayName"
                                  Placeholder="e.g. Administrator"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Typo="Typo.body2"
                                  Counter="100"
                                  MaxLength="100"
                                  For="@(() => Input.DisplayName)" />
                </MudItem>

                <!-- Description -->
                <MudItem xs="12">
                    <MudInputLabel>Description</MudInputLabel>
                    <MudTextField T="string"
                                  @bind-Value="Input.Description"
                                  Placeholder="e.g. Full access to all system modules."
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Typo="Typo.body2"
                                  Lines="3"
                                  Counter="500"
                                  MaxLength="500"
                                  For="@(() => Input.Description)" />
                </MudItem>

                <!-- Position -->
                <MudItem xs="12">
                    <MudInputLabel>Position</MudInputLabel>
                    <MudNumericField T="int"
                                     @bind-Value="Input.Position"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Typo="Typo.body2"
                                     Min="0"
                                     For="@(() => Input.Position)" />
                </MudItem>

                <!-- Is Active -->
                <MudItem xs="12">
                    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudInputLabel>Active</MudInputLabel>
                        <MudSwitch @bind-Value="Input.IsActive"
                                   Color="Color.Primary" />
                    </MudStack>
                </MudItem>

                <!-- Error Alert -->
                @if (!string.IsNullOrEmpty(StatusMessage))
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Error" Class="border-1">@StatusMessage</MudAlert>
                    </MudItem>
                }
            </MudGrid>
        </EditForm>
    </ContentArea>

    <ActionsTemplate>
        <MudButton Disabled="@IsBusy" OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@IsBusy"
                   OnClick="OnSubmitAsync"
                   DropShadow="false">
            @if (IsBusy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate Class="me-2" />
            }
            Add Role
        </MudButton>
    </ActionsTemplate>
</ModalDialog>