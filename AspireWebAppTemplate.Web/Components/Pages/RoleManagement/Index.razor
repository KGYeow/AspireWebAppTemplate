@page "/role-management"
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Role Management</PageTitle>

<PageHeader Title="Role Management" Subtitle="Manage roles and their descriptions." />

<!-- Alert Messages -->
@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <MudAlert Severity="Severity.Error"
              Class="mb-4 border-1"
              ShowCloseIcon
              CloseIconClicked="() => ErrorMessage = null">
        @ErrorMessage
    </MudAlert>
}

@if (!string.IsNullOrEmpty(SuccessMessage))
{
    <MudAlert Severity="Severity.Success"
              Class="mb-4 border-1"
              ShowCloseIcon
              CloseIconClicked="() => SuccessMessage = null">
        @SuccessMessage
    </MudAlert>
}

<!-- Action Buttons Row -->
<MudStack Row Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
    <MudButton Color="Color.Primary"
               Variant="Variant.Filled"
               StartIcon="@Icons.Material.Outlined.AddCircle"
               Disabled="@IsLoading"
               OnClick="OpenAddRoleDialog"
               DropShadow="false"
               Style="text-transform: none;">
        Add Role
    </MudButton>
</MudStack>

<!-- Roles Data Grid — Server-Side Filtering, Sorting & Pagination -->
<MudPaper Elevation="0" Class="pa-4">
    <!-- Search Filter -->
    <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Class="mb-4">
        <MudTextField T="string"
                      ValueChanged="@(s => OnSearch(s))"
                      Placeholder="Search roles..."
                      Variant="Variant.Outlined"
                      Typo="Typo.body2"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Rounded.Search"
                      IconSize="Size.Small"
                      DebounceInterval="500" />
    </MudStack>

    <!-- Bulk actions — visible only when roles are selected -->
    @if (selectedRoles.Count > 0)
    {
        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
            <MudButton StartIcon="@Icons.Material.Rounded.Close"
                       OnClick="ClearSelection"
                       Size="Size.Small"
                       Style="text-transform: none;">
                @selectedRoles.Count selected
            </MudButton>

            <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                <MudTooltip Text="Activate selected">
                    <MudIconButton Icon="material-symbols-rounded/person_check"
                                   OnClick="BulkActivateAsync"
                                   Size="Size.Small" />
                </MudTooltip>

                <MudTooltip Text="Deactivate selected">
                    <MudIconButton Icon="material-symbols-rounded/person_cancel"
                                   OnClick="BulkDeactivateAsync"
                                   Size="Size.Small" />
                </MudTooltip>

                <MudTooltip Text="Delete selected">
                    <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                   Color="Color.Error"
                                   OnClick="BulkDeleteAsync"
                                   Size="Size.Small" />
                </MudTooltip>
            </MudStack>
        </MudStack>
    }

    <MudDataGrid T="RoleViewModel"
                 @ref="dataGrid"
                 ServerData="ServerReload"
                 MultiSelection="true"
                 @bind-SelectedItems="selectedRoles"
                 SelectOnRowClick="false"
                 Loading="@IsLoading"
                 Elevation="0"
                 Filterable
                 Hover
                 Dense
                 Bordered>
    <NoRecordsContent>
        <MudText Typo="Typo.body2">No roles found.</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText Typo="Typo.body2">Loading roles...</MudText>
    </LoadingContent>
    <Columns>
        <SelectColumn T="RoleViewModel" />
        <TemplateColumn Title="#" Sortable="false" Filterable="false">
            <CellTemplate>
                @context.Item.LineNumber
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="r => r.Name" Title="Role Name" />
        <PropertyColumn Property="r => r.DisplayName" Title="Display Name" />
        <PropertyColumn Property="r => r.Description" Title="Description" Hideable="true" />
        <PropertyColumn Property="r => r.IsActive" Title="Status" Filterable="true">
            <FilterTemplate>
                <BoolFilterSelect T="RoleViewModel"
                                  FilterContext="context"
                                  DataGrid="dataGrid"
                                  TrueLabel="Active"
                                  FalseLabel="Inactive" />
            </FilterTemplate>
            <CellTemplate>
                @if (context.Item.IsActive)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Active</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Error" Size="Size.Small">Inactive</MudChip>
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="r => r.UserCount" Title="User Count" />
        <PropertyColumn Property="r => r.Position" Title="Position" Sortable="true" />
        <TemplateColumn Title="" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudStack Row Spacing="1">
                    <MudIconButton Size="Size.Small"
                                   Icon="@Icons.Material.Outlined.Visibility"
                                   Href="@($"/role-management/{context.Item.Id}")"
                                   title="View Details" />
                    <MudIconButton Size="Size.Small"
                                   Icon="@Icons.Material.Outlined.Edit"
                                   OnClick="() => OpenEditRoleDialog(context.Item)"
                                   title="Edit" />
                    @if (context.Item.IsActive)
                    {
                        <MudIconButton Size="Size.Small"
                                       Icon="material-symbols-rounded/person_cancel"
                                       OnClick="() => ToggleActivationAsync(context.Item)"
                                       Disabled="context.Item.IsSystem"
                                       title="Deactivate" />
                    }
                    else
                    {
                        <MudIconButton Size="Size.Small"
                                       Icon="material-symbols-rounded/person_check"
                                       OnClick="() => ToggleActivationAsync(context.Item)"
                                       title="Activate" />
                    }
                    <MudIconButton Size="Size.Small"
                                   Icon="@Icons.Material.Outlined.DeleteOutline"
                                   Color="Color.Error"
                                   OnClick="() => DeleteRoleAsync(context.Item)"
                                   Disabled="context.Item.IsSystem"
                                   title="Delete" />
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="RoleViewModel" />
    </PagerContent>
    </MudDataGrid>
</MudPaper>