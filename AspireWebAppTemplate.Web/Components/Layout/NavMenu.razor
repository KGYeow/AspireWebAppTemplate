﻿@using BlazorWebAppTemplate.Core.Common

<MudNavMenu
    Color="Color.Info"
    Margin="Margin.Dense"
    Class="@NavMenuClass"
    Rounded="DrawerOpen"
    Style="@NavMenuStyle"
>
    <!-- Render each top-level item (recursively handles children for groups) -->
    @foreach (var item in Items ?? Array.Empty<NavItem>())
    {
        @RenderItem(item, isRoot: true)
    }
</MudNavMenu>