@using AspireWebAppTemplate.Core.Contracts.Notifications
@using AspireWebAppTemplate.Core.Domain.Enums

<MudMenu PopoverClass="mud-elevation-25 p-2 notification-bell-popover"
         AnchorOrigin="Origin.BottomRight"
         TransformOrigin="Origin.TopRight"
         Dense>

    <ActivatorContent>
        <MudIconButton Color="Color.Inherit" OnClick="@context.ToggleAsync">
            <MudBadge Content="@_unreadCount" Visible="@(_unreadCount > 0)" Color="Color.Error" Overlap>
                <MudIcon Icon="@Icons.Material.Outlined.Notifications" />
            </MudBadge>
        </MudIconButton>
    </ActivatorContent>

    <ChildContent>
            <!-- Header -->
            <MudStack Row AlignItems="AlignItems.Center" Class="p-2">
                <MudText Typo="Typo.subtitle1" Class="fw-bold">Notifications</MudText>
                <MudSpacer />

                @if (_unreadCount > 0)
                {
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="HandleMarkAllAsRead"
                               Style="text-transform: none;">
                        Mark all read
                    </MudButton>
                }
            </MudStack>

            <MudDivider />

            <!-- Notification List -->
            @if (_recentNotifications is null || _isLoadingRecent)
            {
                <MudStack Class="pa-4" AlignItems="AlignItems.Center">
                    <MudProgressCircular Size="Size.Small" Indeterminate />
                </MudStack>
            }
            else if (_recentNotifications.Count == 0)
            {
                <MudStack Class="pa-4" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Outlined.NotificationsNone"
                             Size="Size.Large"
                             Color="Color.Default" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No notifications</MudText>
                </MudStack>
            }
            else
            {
                <MudList T="NotificationDto" Dense Class="notification-bell-list" Style="max-height: 300px; overflow-y: auto;">
                    @foreach (var notification in _recentNotifications)
                    {
                        <MudListItem T="NotificationDto"
                                     OnClick="() => HandleNotificationClick(notification)"
                                     Class="@(notification.IsRead ? "mb-1" : "notification-unread mb-1")">
                            <MudStack Row AlignItems="AlignItems.Start" Spacing="2">
                                <MudIcon Icon="@GetCategoryIcon(notification.Category)"
                                         Size="Size.Small"
                                         Color="@GetCategoryColor(notification.Category)"
                                         Class="mt-1" />
                                <MudStack Spacing="0" Class="overflow-hidden">
                                    <MudText Typo="Typo.body2"
                                             Class="@(notification.IsRead ? "" : "fw-bold")"
                                             Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                        @notification.Title
                                    </MudText>
                                    <MudText Typo="Typo.caption"
                                             Color="Color.Secondary"
                                             Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                        @notification.Message
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @FormatRelativeTime(notification.CreatedAtUtc)
                                    </MudText>
                                </MudStack>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            }

            <MudDivider />

            <!-- View All Link -->
            <MudStack Row Class="pa-2" Justify="Justify.Center">
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           OnClick="NavigateToNotifications"
                           Style="text-transform: none;">
                    View All
                </MudButton>
            </MudStack>
        </ChildContent>
    </MudMenu>
