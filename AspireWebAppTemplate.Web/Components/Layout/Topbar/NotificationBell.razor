@using AspireWebAppTemplate.Core.Contracts.Notifications
@using AspireWebAppTemplate.Core.Domain.Enums

<MudMenu @ref="_menuRef"
         PopoverClass="mud-elevation-25 p-2 notification-bell-popover"
         ListClass="px-1"
         AnchorOrigin="Origin.BottomRight"
         TransformOrigin="Origin.TopRight"
         Dense>
         
    <ActivatorContent>
        <MudBadge Content="@_unreadCount"
                  Visible="@(_unreadCount > 0)"
                  BadgeClass=""
                  Color="Color.Error"
                  Overlap>
            <MudIconButton Color="Color.Inherit" OnClick="@context.ToggleAsync">
                <MudIcon Icon="@Icons.Material.Outlined.Notifications" />
             </MudIconButton>
        </MudBadge>
    </ActivatorContent>

    <ChildContent>
        <!-- Header -->
        <MudStack Row AlignItems="AlignItems.Center" Class="px-1">
            <MudText Typo="Typo.subtitle1" Class="fw-bold">Notifications</MudText>
            <MudSpacer />

            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       Size="Size.Small"
                       OnClick="HandleMarkAllAsRead"
                       Disabled="@(_unreadCount == 0)"
                       Style="text-transform: none;">
                Mark all read
            </MudButton>
        </MudStack>

        <MudDivider />

        <!-- Notification List -->
        @if (_recentNotifications is null || _isLoadingRecent)
        {
            @for (int i = 0; i < 3; i++)
            {
                <MudStack Row AlignItems="AlignItems.Start" Spacing="2" Class="px-3 py-1 mb-1" Style="width: 300px">
                    <MudSkeleton SkeletonType="SkeletonType.Circle" Width="32px" Height="32px" />
                    <MudStack Spacing="1" Class="flex-grow-1">
                        <MudSkeleton Width="60%" Height="15px" />
                        <MudSkeleton Width="100%" Height="12px" />
                        <MudSkeleton Width="30%" Height="10px" />
                    </MudStack>
                </MudStack>
            }
        }
        else if (_recentNotifications.Count == 0)
        {
            <MudStack Class="pa-4" Spacing="2" AlignItems="AlignItems.Center" Style="width: 300px">
                <MudIcon Icon="@Icons.Material.Rounded.NotificationsNone" Size="Size.Large" Color="Color.Default" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">No notifications</MudText>
            </MudStack>
        }
        else
        {
            <MudList T="NotificationDto" Dense Class="notification-bell-list overflow-y-auto" Style="max-height: 300px;">
                @foreach (var notification in _recentNotifications)
                {
                    <MudListItem T="NotificationDto"
                                 OnClick="() => HandleNotificationClick(notification)"
                                 Class="@($"mb-1 px-3{(notification.IsRead ? "" : " notification-unread")}")">

                        <MudStack Row AlignItems="AlignItems.Start" Spacing="2">
                            <MudAvatar Size="Size.Small" Class="@GetCategoryColor(notification.Category)" Variant="Variant.Text">
                                <MudIcon Icon="@GetCategoryIcon(notification.Category)" Style="font-size: 16px" />
                            </MudAvatar>

                            <MudStack Spacing="0" Class="overflow-hidden">
                                <MudText Typo="Typo.body2"
                                         Class="@(notification.IsRead ? "" : "fw-bold")"
                                         Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    @notification.Title
                                </MudText>
                                <MudText Typo="Typo.caption"
                                         Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    @notification.Message
                                </MudText>
                                <MudText Typo="Typo.caption" Class="text-muted">
                                    @FormatRelativeTime(notification.CreatedAtUtc)
                                </MudText>
                            </MudStack>
                        </MudStack>

                    </MudListItem>
                }
            </MudList>
        }

        <MudDivider />

        <!-- View All Link -->
        <MudStack Row Class="px-1" Justify="Justify.Center">
            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       Size="Size.Small"
                       OnClick="NavigateToNotifications"
                       Style="text-transform: none;">
                View All
            </MudButton>
        </MudStack>
    </ChildContent>
</MudMenu>
