@using AspireWebAppTemplate.Core.Common

@*
    Pure renderer: NavMenu fetches the pre-filtered navigation tree from the API
    and renders it directly. No client-side filtering is performed.
    1. Loading state — show skeleton placeholder while the API call is in-flight
    2. Success — render the received tree directly (no filtering applied)
    3. Failure — render empty navigation (zero items)
*@

@if (_isLoading)
{
    <!-- Loading skeleton placeholder while the API navigation call is in-flight.
         Prevents flash of empty content before the filtered tree is received. -->
    <div class="pa-4">
        <MudSkeleton Width="80%" Height="28px" Class="mb-2" />
        <MudSkeleton Width="60%" Height="28px" Class="mb-2" />
        <MudSkeleton Width="70%" Height="28px" Class="mb-2" />
        <MudSkeleton Width="50%" Height="28px" Class="mb-2" />
        <MudSkeleton Width="65%" Height="28px" />
    </div>
}
else
{
    <MudNavMenu
        Color="Color.Info"
        Margin="Margin.Dense"
        Class="@NavMenuClass"
        Rounded="DrawerOpen"
        Style="@NavMenuStyle"
    >
        @foreach (var item in _navItems)
        {
            @RenderItem(item, isRoot: true)
        }
    </MudNavMenu>
}
