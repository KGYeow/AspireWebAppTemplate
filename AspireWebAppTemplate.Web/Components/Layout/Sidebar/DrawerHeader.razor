<MudDrawerHeader Dense="Dense" Class="d-flex align-center justify-center">
    <MudLink Href="@LogoHref" Class="d-flex align-center justify-center" Underline="Underline.None">
        @if (DrawerOpen)
        {
            <!-- Full logo shown when the sidebar is expanded -->
            <MudImage Src="@LogoSrc" Height="@LogoHeight" Alt="@Alt" />
        }
        else
        {
            <!-- Compact/icon logo shown when the sidebar is minimized -->
            <MudImage Src="@ResolvedMiniLogoSrc" Height="@MiniLogoHeight" Alt="@Alt" />
        }
    </MudLink>
</MudDrawerHeader>
